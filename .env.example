# Copiar a `.env` y completar con los valores del dashboard de EmailJS.
#
#   Service ID  → Email Services → el servicio conectado
#   Template ID → Email Templates → la plantilla de contacto
#   Public Key  → Account → General
#
# El prefijo VITE_ es obligatorio: sin él Vite no expone la variable al cliente.
# La Public Key de EmailJS es pública por diseño; el abuso se limita
# restringiendo el dominio permitido desde el dashboard de EmailJS.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
